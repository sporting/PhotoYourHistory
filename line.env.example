# Copy to a private file on the Synology NAS and chmod 600 it.
export LINE_CHANNEL_ACCESS_TOKEN="replace-with-channel-access-token"
export LINE_CHANNEL_SECRET="replace-with-channel-secret"
export LINE_GROUP_WHITELIST="replace-with-Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
export LINE_IMAGE_BASE_URL="https://photos.example.com"
export LINE_IMAGE_SIGNING_SECRET="generate-a-long-random-secret"
export LINE_IMAGE_ROOTS="/volume1/photo"
export LINE_IMAGE_TTL_SECONDS="172800"
# 0 means all items selected by the existing historical-photo selector.
export LINE_MAX_IMAGES="0"
# Safety cap for message objects emitted by this task; check actual plan quota.
export LINE_MAX_MESSAGE_OBJECTS_PER_DAY="20"
export LINE_USAGE_LOG_PATH="/volume1/PhotoYourHistory/line-message-usage.jsonl"

